{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "rootDir": "src", "outDir": "dist", "noEmitOnError": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
