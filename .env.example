# Local development needs no environment variables. Do not put secrets in this file.
# Production: set NODE_ENV=production in the hosting service.

# Public website (required in production)
# PUBLIC_ORIGIN=https://your-domain.example
# Railway supplies RAILWAY_PUBLIC_DOMAIN for its temporary domain.
# HOST_SESSION_SECRET=replace-with-at-least-32-random-characters
# MATCHES_DIR=/data/matches
# PORT is supplied by the host. HOST defaults to 0.0.0.0 in production.

# Optional inference. Mock strategies work without these.
# MODEL_BASE_URL=https://approved-provider.example/v1
# MODEL_API_KEY_ENV=MODEL_API_KEY
# MODEL_API_KEY=your-server-side-key

# Development-only experiments; public production rejects these.
# ECONOMY_LAB=1
# MACHINE_PAYMENTS_DEMO=1
# FUNDED_AUTO_RUN=0

# Public paid-entry matches are not enabled. Mainnet is unsupported.
# ENTRY_FEE_ENABLED=false
# ECONOMY_MODE=SIMULATED
