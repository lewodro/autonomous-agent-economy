# Example only. Never paste real secrets into this tracked file.
# Local development works without any variables. Production uses the hosting provider's secret/environment settings.

# APP — one long-running service, one canonical HTTPS origin.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://lastseat.ing  # Canonical HTTPS origin; no trailing slash.
# PORT=3000  # Hosting providers supply this automatically; do not hardcode it in production.
# HOST=0.0.0.0  # Default in production.

# STORAGE — MATCHES_DIR must be an absolute persistent volume path in production.
# MATCHES_DIR=/data/matches
# EXPERIMENT_MAX_MATCHES=8  # Maximum retained private experiments per browser, 1–20.
# EXPERIMENT_RETENTION_DAYS=30  # Completed private experiment checkpoints expire after 1–365 days.
# EVENT_LOG_MAX_SIZE=32000000  # Max private checkpoint/export bytes, 1–32 MB.

# SESSION — generate once with: openssl rand -hex 32
# HOST_SESSION_SECRET=<64-HEX-CHARACTERS>  # Stable across deploys; signs anonymous and host cookies.

# PRESENCE — the single service owns the shared world and its SSE feeds.
# No variable is required for free public presence.

# MODEL PROVIDERS — free public launch leaves provider spending disabled.
# ENABLE_PUBLIC_MODEL_INFERENCE=false
# MODEL_BASE_URL=https://<APPROVED-PROVIDER>/v1
# MODEL_API_KEY_ENV=MODEL_API_KEY  # Name of the server-side key variable.
# MODEL_API_KEY=<SECRET>  # Optional, server-side only; never place in agent JSON.
# AGENT_HTTP_ENDPOINT=https://<APPROVED-PROVIDER>/decide
# AGENT_HTTP_TOKEN=<SECRET>

# SOLANA — optional, experimental DEVNET only; no real value.
# SOLANA_DEVNET_RPC_URL=https://<DEDICATED-DEVNET-RPC>
# PUBLIC_DEVNET_ACK=I_UNDERSTAND_TEST_SOL_ONLY

# ECONOMY — keep free public launch simulated and paid entry off.
# ECONOMY_MODE=SIMULATED
# ENTRY_FEE_ENABLED=false
# FUNDED_AUTO_RUN=0
# ECONOMY_DIR=/data/matches/economy  # Only if economy experiments are enabled separately.

# FEATURE FLAGS — production rejects economy labs and payment demos.
# ECONOMY_LAB=0
# MACHINE_PAYMENTS_DEMO=0
# PREDICTIONS_ENABLED=false  # Public prediction routes are not implemented.
# WORLD_LAB=0

# SOCIAL / EXTERNAL AGENTS — current adapters are manual, in-memory boundaries only.
# No X, Moltbook, GitHub App, or external-network credential is read by this release.
# Do not add personal access tokens to agent JSON or public environment output.

# LOCAL TOOLS — never expose an MCP bridge to a public URL.
# MCP_ARENA_BASE_URL=http://127.0.0.1:3000
# MCP_ARENA_SESSION_FILE=matches/mcp/host-sessions.json

# DEPLOYMENT VERIFIER — only for the machine running the verification command.
# DEPLOYMENT_VERIFY_URL=https://lastseat.ing
