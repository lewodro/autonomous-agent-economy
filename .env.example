# Copy to .env for local overrides. Free mode needs no secrets or RPC.
# Never commit real credentials. The normal tutorial does not use blockchain.

# APPLICATION / HOSTING
# Required in production; use the deployment guide for a persistent volume.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# Railway supplies RAILWAY_PUBLIC_DOMAIN for its temporary domain.
# HOST_SESSION_SECRET=replace-with-at-least-32-random-characters
# MATCHES_DIR=/data/matches
# PORT is supplied by the host. HOST defaults to 0.0.0.0 in production.
# APP_MODE=free  # free | mock | local-validator | devnet. Default: free.
# TRUST_PROXY=false  # Set true only behind trusted ingress overwriting X-Real-IP or X-Forwarded-For.

# WALLET OWNERSHIP
# No extra variable is needed for optional wallet sign-in. The host secret above
# signs owner sessions. The browser wallet signs an expiring challenge; no key is
# sent to or stored by the server.

# SOLANA / MATCH ECONOMY
# SOLANA_NETWORK=none  # none | localnet | devnet. mainnet-beta is not implemented.
# Public production rejects mock/local-validator mode and requires the explicit
# test-SOL settings below before devnet match funding can be exposed.
# Mainnet ownership/funding is NOT IMPLEMENTED and is rejected at startup.
# ENABLE_MAINNET_AGENT_FUNDING=false
# Mainnet wagering is permanently rejected by this build.
# ENABLE_MAINNET_MATCH_WAGERING=false
# SOLANA_DEVNET_RPC_URL=https://your-dedicated-devnet-rpc.example

# OPTIONAL LOCAL MCP BRIDGE (loopback only)
# MCP_ARENA_BASE_URL=http://127.0.0.1:3000
# MCP_ARENA_SESSION_FILE=matches/mcp/host-sessions.json

# OPTIONAL MODEL INFERENCE (mock strategies work without a provider)
# Public production match creation rejects server-paid inference by default.
# Enable only when you intentionally accept provider costs; backed runs are
# limited to 2 new matches per minute per app process.
# ENABLE_PUBLIC_MODEL_INFERENCE=false
# MODEL_BASE_URL=https://approved-provider.example/v1
# MODEL_API_KEY_ENV=MODEL_API_KEY
# MODEL_API_KEY=your-server-side-key

# DEVELOPMENT-ONLY EXPERIMENTS; public production rejects these.
# ECONOMY_LAB=1
# MACHINE_PAYMENTS_DEMO=1
# FUNDED_AUTO_RUN=0

# Free public launch leaves paid entry and predictions off.
# ENTRY_FEE_ENABLED=false
# ECONOMY_MODE=SIMULATED
# To opt into PUBLIC TEST-SOL funded matches only:
# ENTRY_FEE_ENABLED=true
# ECONOMY_MODE=DEVNET
# PUBLIC_DEVNET_ACK=I_UNDERSTAND_TEST_SOL_ONLY
# Prediction state is an unmounted experiment; there is no public route/payment flow yet.
# Setting PREDICTIONS_ENABLED=true is rejected at startup, including in Devnet mode.
