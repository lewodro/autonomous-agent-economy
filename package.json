{
  "name": "autonomous-agent-economy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test && node scripts/test-mcp-bridge.js",
    "check": "node scripts/check.js",
    "simulate": "node scripts/simulate.js",
    "verify": "node scripts/verify-audit.js",
    "demo:crypto": "node demos/crypto.js",
    "demo:solana": "node demos/solana.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:browser:legacy": "node scripts/legacy-browser-smoke.js",
    "test:browser:world": "node scripts/world-browser-smoke.js",
    "dev": "node scripts/dev.js",
    "build": "cargo build --manifest-path rust/Cargo.toml --locked && tsc -p web/tsconfig.json",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "table:run": "cargo run --manifest-path rust/Cargo.toml --bin table-core --",
    "demo:wallet": "cargo run --manifest-path rust/Cargo.toml --bin wallet-demo --",
    "pretest": "npm run build",
    "match": "node scripts/table-run.js",
    "prematch": "npm run build",
    "demo:payments": "node scripts/payment-demo.js",
    "balance": "cargo run --manifest-path rust/Cargo.toml --bin balance-report --",
    "lint": "npm run check && npm run typecheck && cargo fmt --manifest-path rust/Cargo.toml --check",
    "demo:economy": "cargo run --manifest-path rust/Cargo.toml --locked --bin economy-demo --",
    "test:browser:economy": "node scripts/economy-browser-smoke.js",
    "test:browser:funded": "node scripts/funded-browser-smoke.js",
    "solana:local": "node scripts/start-local-validator.js",
    "demo:funded-local": "cargo run --manifest-path rust/Cargo.toml --locked --bin funded-local-demo --",
    "economy:reconcile": "cargo run --manifest-path rust/Cargo.toml --locked --bin funded-local-demo -- --reconcile",
    "doctor": "node scripts/doctor.js",
    "config:check": "cargo run --manifest-path rust/Cargo.toml --locked --bin config-check --",
    "examples:check": "node scripts/validate-examples.js",
    "docs:check": "node scripts/check-docs.js",
    "verify:production": "node scripts/verify-production.js",
    "demo:devnet-wallets": "node scripts/devnet-wallets.js",
    "mcp:arena": "node mcp/server.js",
    "test:mcp": "node scripts/test-mcp-bridge.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  }
}
